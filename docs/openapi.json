                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "ErrorBody": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code",
            "description": "Stable machine-readable code",
            "examples": ["invalid_otp"]
          },
          "message": {
            "type": "string",
            "title": "Message",
            "examples": ["Incorrect or expired code"]
          },
          "request_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Request Id",
            "description": "Also returned in the x-request-id header"
          },
          "fields": {
            "anyOf": [
              {
                "items": {
                  "additionalProperties": true,
                  "type": "object"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Fields",
            "description": "Only on 422: per-field validation problems"
          }
        },
        "type": "object",
        "required": ["code", "message"],
        "title": "ErrorBody"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "type": "object",
        "required": ["error"],
        "title": "ErrorResponse"
      },
      "GoogleSignInIn": {
        "properties": {
          "id_token": {
            "type": "string",
            "title": "Id Token",
            "description": "ID token from native Google Sign-In on the device"
          }
        },
        "type": "object",
        "required": ["id_token"],
        "title": "GoogleSignInIn"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "OtpRequestIn": {
        "properties": {
          "country_code": {
            "type": "string",
            "title": "Country Code",
            "description": "Dialling code of the country, with or without +",
            "examples": ["+91"]
          },
          "mobile_number": {
            "type": "string",
            "title": "Mobile Number",
            "description": "Mobile number without the country code",
            "examples": ["9812345678"]
          }
        },
        "type": "object",
        "required": ["country_code", "mobile_number"],
        "title": "OtpRequestIn"
      },
      "OtpVerifyIn": {
        "properties": {
          "country_code": {
            "type": "string",
            "title": "Country Code",
            "examples": ["+91"]
          },
          "mobile_number": {
            "type": "string",
            "title": "Mobile Number",
            "examples": ["9812345678"]
          },
          "code": {
            "type": "string",
            "maxLength": 10,
            "minLength": 4,
            "title": "Code",
            "examples": ["123456"]
          }
        },
        "type": "object",
        "required": ["country_code", "mobile_number", "code"],
        "title": "OtpVerifyIn"
      },
      "ProfileOut": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "display_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Display Name"
          },
          "avatar_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Avatar Url"
          },
          "profile_status": {
            "$ref": "#/components/schemas/ProfileStatus"
          }
        },
        "type": "object",
        "required": ["id", "display_name", "avatar_url", "profile_status"],
        "title": "ProfileOut"
      },
      "ProfilePatchIn": {
        "properties": {
          "display_name": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Display Name",
            "description": "Saving a name marks the profile completed",
            "examples": ["Asha"]
          },
          "avatar_url": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2048
              },
              {
                "type": "null"
              }
            ],
            "title": "Avatar Url"
          }
        },
        "type": "object",
        "title": "ProfilePatchIn"
      },
      "ProfileStatus": {
        "type": "string",
        "enum": ["pending", "completed", "skipped"],
        "title": "ProfileStatus"
      },
      "RefreshIn": {
        "properties": {
          "refresh_token": {
            "type": "string",
            "title": "Refresh Token"
          }
        },
        "type": "object",
        "required": ["refresh_token"],
        "title": "RefreshIn"
      },
      "SignInOut": {
        "properties": {
          "access_token": {
            "type": "string",
            "title": "Access Token"
          },
          "token_type": {
            "type": "string",
            "title": "Token Type",
            "default": "bearer"
          },
          "refresh_token": {
            "type": "string",
            "title": "Refresh Token"
          },
          "user_id": {
            "type": "string",
            "format": "uuid",
            "title": "User Id"
          },
          "is_new": {
            "type": "boolean",
            "title": "Is New",
            "description": "True if this sign-in created the account"
          }
        },
        "type": "object",
        "required": ["access_token", "refresh_token", "user_id", "is_new"],
        "title": "SignInOut"
      },
      "TokenOut": {
        "properties": {
          "access_token": {
            "type": "string",
            "title": "Access Token"
          },
          "token_type": {
            "type": "string",
            "title": "Token Type",
            "default": "bearer"
          }
        },
        "type": "object",
        "required": ["access_token"],
        "title": "TokenOut"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": ["loc", "msg", "type"],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  },
  "tags": [
